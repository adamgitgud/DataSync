{
  "name": "datasync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.thresholds.functions=100 --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.statements=90",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/standard-validator": "^0.4.0",
    "@hono/swagger-ui": "^0.6.1",
    "@valibot/to-json-schema": "^1.7.1",
    "hono": "^4.13.7",
    "hono-openapi": "^1.3.2",
    "swagger-ui-dist": "^5.32.15",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^20.19.43",
    "@types/swagger-ui-dist": "^3.30.6",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "openapi-schema-validator": "^12.1.3",
    "openapi-types": "^12.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
